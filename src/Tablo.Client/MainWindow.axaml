<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Tablo.Client.MainWindow"
        Title="Табло судебных заседаний"
        Background="#0B0F14"
        Cursor="None"
        WindowStartupLocation="CenterScreen">
    <!-- Cursor="None" — табло без взаимодействия мышью, курсор поверх
         списка дел не нужен (см. также HideCursorNow в MainWindow.axaml.cs). -->
    <DockPanel>
        <!--
            Статус-строку сознательно оставляем вне LayoutTransformControl —
            её не масштабируем даже при увеличенном UiScale.
        -->
        <Border DockPanel.Dock="Bottom" Background="#12161C" Padding="16,8">
            <TextBlock x:Name="StatusText"
                       Foreground="#7A8896"
                       FontSize="16"
                       Text="Загрузка..." />
        </Border>

        <!--
            LayoutTransformControl (не RenderTransform!) — масштаб учитывается
            при раскладке, а не только при отрисовке, поэтому контент
            переносится по словам в пределах экрана вместо того, чтобы
            вылезать за правый край при UiScale > 1.
        -->
        <LayoutTransformControl x:Name="ScaleContainer">
            <LayoutTransformControl.LayoutTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </LayoutTransformControl.LayoutTransform>

            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#151B22" Padding="24,20">
                    <TextBlock x:Name="TitleText"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </Border>

                <ScrollViewer x:Name="ContentScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ContentPanel" Margin="32" />
                </ScrollViewer>
            </DockPanel>
        </LayoutTransformControl>
    </DockPanel>
</Window>
