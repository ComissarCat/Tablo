# systemd --user unit для табло на Linux — АЛЬТЕРНАТИВА основному способу
# (install-client-autostart.sh, XDG-автозапуск). Работает только в
# окружениях, которые при входе активируют graphical-session.target и
# передают DISPLAY/XAUTHORITY в systemd --user (GNOME, KDE Plasma). В
# остальных (XFCE, MATE, Fly и т.п.) сервис либо не стартует, либо падает с
# "XOpenDisplay failed" — там используйте install-client-autostart.sh.
#
# Установка (под учёткой, которая автологинится в зале):
#   chmod +x ~/tablo-client/Tablo.Client
#   mkdir -p ~/.config/systemd/user
#   cp tablo-client.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable tablo-client.service
# и перелогиниться (сервис стартует вместе с графической сессией).
#
# Restart=on-failure — watchdog как у bat/sh-цикла: падение перезапускает,
# штатный выход по Esc (код 0) — нет.

[Unit]
Description=Tablo — табло судебных заседаний
# Привязка к графической сессии: стартовать только после неё (иначе ещё нет
# X-сервера — "XOpenDisplay failed") и останавливаться вместе с ней.
PartOf=graphical-session.target
After=graphical-session.target
# Если процесс не может подняться (например, битый исполняемый файл) —
# не долбить лог бесконечно быстрыми рестартами.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/tablo-client/Tablo.Client
WorkingDirectory=%h/tablo-client
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
